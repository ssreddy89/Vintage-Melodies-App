<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <!-- Splash branding (matching modal card styling from reference) -->
    <LinearLayout
        android:id="@+id/splash_branding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:paddingStart="36dp"
        android:paddingTop="36dp"
        android:paddingEnd="36dp"
        android:paddingBottom="36dp"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_music_note"
            android:contentDescription="@string/content_description_brand_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_brand"
            android:textSize="26sp"
            android:textColor="@color/amber_light"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_tagline"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="6dp" />

        <ProgressBar
            android:id="@+id/splash_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/amber_accent" />
    </LinearLayout>

    <!-- Error state (styled with glassmorphic modal card) -->
    <LinearLayout
        android:id="@+id/splash_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:paddingStart="28dp"
        android:paddingTop="32dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_music_note"
            android:contentDescription="@string/content_description_brand_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_brand"
            android:textSize="22sp"
            android:textColor="@color/amber_light"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_no_internet_title"
            android:textSize="17sp"
            android:textColor="@color/warm_gold"
            android:layout_marginTop="18dp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_no_internet_message"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <Button
            android:id="@+id/splash_retry_btn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/btn_retry"
            android:background="@drawable/bg_retry_button"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</FrameLayout>
