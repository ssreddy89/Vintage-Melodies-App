<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_dialog_playlist_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="➕ Create New Playlist"
            android:textColor="@color/amber_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1. Playlist Name Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Playlist Name:"
            android:textColor="@color/warm_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_new_playlist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Monsoon Melodies"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/input_hint"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="14sp" />

        <!-- 2. Language Dropdown Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Language:"
            android:textColor="@color/warm_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinner_playlist_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:background="@drawable/bg_input_field"
            android:popupBackground="@drawable/bg_dialog_card"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <!-- 3. Picture / Background Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp"
            android:text="Background Picture / GIF:"
            android:textColor="@color/warm_gold"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Changes app background while playing this playlist:"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Preset Vintage Picture Carousel -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_picture_picker"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal" />

        <!-- Choose File Button (Item 8: gif or pic) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_choose_custom_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:background="@drawable/bg_pill_button"
                android:text="📁 Choose from Device (Pic / GIF)"
                android:textColor="@color/warm_gold"
                android:textSize="12sp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:includeFontPadding="false"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Custom File Preview (shown when a file is picked) -->
        <LinearLayout
            android:id="@+id/layout_custom_file_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_custom_file_thumb"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:scaleType="centerCrop"
                android:src="@drawable/vm_art_village" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_custom_file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom File Selected"
                    android:textColor="@color/amber_light"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active as playlist background"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_remove_custom_file"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="@color/text_muted"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Action Buttons (Responsive & Never Truncated) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_cancel_create_playlist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_button"
                android:text="Cancel"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:includeFontPadding="false"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_confirm_create_playlist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:background="@drawable/bg_retry_button"
                android:text="Save Playlist"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:includeFontPadding="false"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
