<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outermost soft halo (#4caad3) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#254CAAD3" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Mid glow layer -->
    <item android:left="3dp" android:right="3dp" android:top="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#454CAAD3" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Intense neon halo rim -->
    <item android:left="5dp" android:right="5dp" android:top="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#754CAAD3" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Inner semi-transparent acrylic container with glowing border -->
    <item android:left="7dp" android:right="7dp" android:top="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neon_player_card_bg" />
            <stroke
                android:width="1.8dp"
                android:color="@color/neon_border" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
